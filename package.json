{
  "name": "better-grades",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "corepack pnpm run visuals:check && node tools/generate-glossary-artifacts.mjs && vinext build",
    "start": "vinext start",
    "build:pages": "corepack pnpm run build && node tools/prepare-pages-build.mjs",
    "article:compile": "node tools/article-source.mjs",
    "glossary:generate": "node tools/generate-glossary-artifacts.mjs",
    "visuals:compile": "node tools/visualization/compile-visuals.mjs",
    "visuals:check": "node tools/visualization/compile-visuals.mjs --check",
    "verify:visuals": "corepack pnpm test && node tools/visualization/verify-visuals.mjs",
    "test": "corepack pnpm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.75.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "drizzle-orm": "0.45.2",
    "jsxgraph": "1.12.2",
    "katex": "^0.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "uplot": "1.6.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
