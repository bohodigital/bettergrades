  "assessments": [
    {
      "assessment_id": "calc-1-unit-2a-derivative-foundations-techniques:chain-rule-concept-quiz",
      "items": [
        {
          "item_id": "chain-rule-concept-quiz-01",
          "model_response": "Each derivative converts change through one stage, so the intermediate units cancel and the local scale factors multiply."
        },
        {
          "item_id": "chain-rule-concept-quiz-02",
          "model_response": "Square root, add one, square, sine, and multiply by three are the nested stages, with constants not counted as functions unless useful for the map."
        },
        {
          "item_id": "chain-rule-concept-quiz-03",
          "model_response": "The derivative of the inner expression, 2x, is missing."
        },
        {
          "item_id": "chain-rule-concept-quiz-04",
          "model_response": "The product rule is applied to the outer product before differentiating its factors."
        },
        {
          "item_id": "chain-rule-concept-quiz-05",
          "model_response": "Because ln u is a composition of ln with u(x), so the chain rule gives (1/u)u'."
        },
        {
          "item_id": "chain-rule-concept-quiz-06",
          "model_response": "For example [2xe^{x^2}x-e^{x^2}]/x^2 and e^{x^2}(2x^2-1)/x^2."
        }
      ]
    },
    {
      "assessment_id": "calc-1-unit-2a-derivative-foundations-techniques:core-rules-concept-quiz",
      "items": [
        {
          "item_id": "core-rules-concept-quiz-01",
          "model_response": "A constant output does not change when the input changes."
        },
        {
          "item_id": "core-rules-concept-quiz-02",
          "model_response": "One term records change in the first factor while the second is held locally fixed; the other records change in the second factor."
        },
        {
          "item_id": "core-rules-concept-quiz-03",
          "model_response": "The rate of a ratio depends on both numerator and denominator values, not only their separate rates."
        },
        {
          "item_id": "core-rules-concept-quiz-04",
          "model_response": "Expansion is preferable when it produces fewer or simpler terms than applying product structure."
        },
        {
          "item_id": "core-rules-concept-quiz-05",
          "model_response": "4x^{-2/3}; its derivative is -(8/3)x^{-5/3}."
        },
        {
          "item_id": "core-rules-concept-quiz-06",
          "model_response": "The chain rule is primary because the whole expression is a power of an inner function."
        }
      ]
    },
    {
      "assessment_id": "calc-1-unit-2a-derivative-foundations-techniques:foundations-concept-quiz",
      "items": [
        {
          "item_id": "foundations-concept-quiz-01",
          "model_response": "Secant slopes from both sides must approach the same finite number."
        },
        {
          "item_id": "foundations-concept-quiz-02",
          "model_response": "f'(a) is one number; f'(x) is a function assigning a derivative to inputs."
        },
        {
          "item_id": "foundations-concept-quiz-03",
          "model_response": "A derivative gives a linear approximation whose error is smaller than the input change, forcing function values to approach f(a)."
        },
        {
          "item_id": "foundations-concept-quiz-04",
          "model_response": "No. A vertical tangent corresponds to unbounded slope, not a finite derivative."
        },
        {
          "item_id": "foundations-concept-quiz-05",
          "model_response": "Use point (2,f(2)) and slope -5."
        },
        {
          "item_id": "foundations-concept-quiz-06",
          "model_response": "Square meters per meter, which simplifies dimensionally to meters but should be interpreted as area change per radius change."
        }
      ]
    },
    {
      "assessment_id": "calc-1-unit-2a-derivative-foundations-techniques:implicit-inverse-concept-quiz",
      "items": [
        {
          "item_id": "implicit-inverse-concept-quiz-01",
          "model_response": "The chain rule: y depends on x, so d(y^4)/dx=4y^3y'."
        },
        {
          "item_id": "implicit-inverse-concept-quiz-02",
          "model_response": "Horizontal tangents occur where the numerator is zero and denominator is nonzero."
        },
        {
          "item_id": "implicit-inverse-concept-quiz-03",
          "model_response": "Swapping input and output swaps rise and run, so a nonzero slope becomes its reciprocal."
        },
        {
          "item_id": "implicit-inverse-concept-quiz-04",
          "model_response": "At x=±1; it is finite only for |x|<1."
        },
        {
          "item_id": "implicit-inverse-concept-quiz-05",
          "model_response": "When products, quotients, roots, or variable exponents become simpler after taking logs."
        },
        {
          "item_id": "implicit-inverse-concept-quiz-06",
          "model_response": "Both base and exponent vary, so taking logs turns the exponent into a product."
        }
      ]
    },
    {
      "assessment_id": "calc-1-unit-2a-derivative-foundations-techniques:special-functions-concept-quiz",
      "items": [
        {
          "item_id": "special-functions-concept-quiz-01",
          "model_response": "The limit sin u/u -> 1 as u -> 0."
        },
        {
          "item_id": "special-functions-concept-quiz-02",
          "model_response": "Cosine is decreasing near π/2, so its local slope is negative."
        },
        {
          "item_id": "special-functions-concept-quiz-03",
          "model_response": "The base e is defined so its proportional growth constant is 1."
        },
        {
          "item_id": "special-functions-concept-quiz-04",
          "model_response": "x^n has a variable base and constant exponent; a^x has a constant base and variable exponent."
        },
        {
          "item_id": "special-functions-concept-quiz-05",
          "model_response": "x≠0 for d/dx ln|x|=1/x."
        },
        {
          "item_id": "special-functions-concept-quiz-06",
          "model_response": "ln a is positive for a>1 and negative for 0<a<1, setting the sign of the derivative."
        }
      ]
    },
